# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Em produção (DJANGO_DEBUG=False) o projeto se recusa a subir com a chave de
# exemplo ou com menos de 50 caracteres.
SECRET_KEY=change-me
# O padrão do código é False. Ligue apenas em desenvolvimento local.
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Sem esta variável o projeto usa SQLite em backend/db.sqlite3, que é o
# suficiente para desenvolver. Descomente só se quiser espelhar o PostgreSQL de
# produção localmente (docker compose up -d).
# DATABASE_URL=postgres://wageup:wageup@localhost:5432/wageup

# ---------------------------------------------------------------------------
# Pagamentos (Abacate Pay)
# ---------------------------------------------------------------------------
# Deixe vazio se ainda não tem a chave. Um texto qualquer aqui não é "vazio":
# o código tenta usar e a Abacate Pay recusa.
ABACATE_PAY_API_KEY=
# Obrigatório em produção: sem ele o webhook é recusado com 503, porque qualquer
# um poderia postar um evento e marcar uma cobrança como paga.
ABACATE_PAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Papéis de usuário
# ---------------------------------------------------------------------------
WAGEUP_ADMIN_EMAILS=admin@wageup.local

# ---------------------------------------------------------------------------
# Inteligência artificial
# ---------------------------------------------------------------------------
# Vazio é o valor certo enquanto você não tem a chave: a plataforma responde
# localmente e avisa que a IA não está configurada. Um texto de exemplo aqui
# faz o código tentar usar e o provedor devolver erro de autenticação.
#
# Anthropic: campanhas de marketing e insights do dashboard.
ANTHROPIC_API_KEY=
# DeepSeek: assistente financeiro. Sem esta chave o assistente cai para a
# Anthropic e, sem nenhuma das duas, responde localmente avisando que não está
# configurado — em vez de quebrar.
DEEPSEEK_API_KEY=
# Opcionais: só mude se precisar apontar para outro endpoint ou modelo.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# E-mail (recuperacao de senha)
# ---------------------------------------------------------------------------
# Sem RESEND_API_KEY nem EMAIL_HOST a mensagem e impressa no console do
# runserver, com link e tudo: da para testar a recuperacao inteira sem
# configurar provedor nenhum. Em producao sem isso o link nunca chega.
#
# Opcao 1 — Resend (API HTTP, plano gratuito): crie a chave em resend.com.
# Sem dominio verificado la, so entrega para o e-mail da propria conta, a
# partir de onboarding@resend.dev. Para qualquer usuario, verifique um
# dominio e use um remetente dele em DEFAULT_FROM_EMAIL.
# RESEND_API_KEY=re_...
# DEFAULT_FROM_EMAIL=WageUp <onboarding@resend.dev>
#
# Opcao 2 — SMTP generico (Gmail com senha de app, SendGrid...):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu@email.com
# EMAIL_HOST_PASSWORD=senha-de-app
# DEFAULT_FROM_EMAIL=WageUp <nao-responda@seudominio.com>
# Validade do link de recuperacao, em segundos (default 7200 = 2 horas).
# PASSWORD_RESET_TIMEOUT=7200

# ---------------------------------------------------------------------------
# Login com Google (opcional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Limites de requisição (throttling). Valores padrão do código entre parênteses.
# ---------------------------------------------------------------------------
# THROTTLE_ANON=30/min      # visitante não autenticado (30/min)
# THROTTLE_USER=120/min     # usuário autenticado (120/min)
# THROTTLE_AI=60/hour       # rotas que chamam modelo de linguagem (60/hour)
# THROTTLE_LOGIN=10/min     # login, registro e login com Google (10/min)

# ---------------------------------------------------------------------------
# HTTPS / HSTS — só valem quando DJANGO_DEBUG=False
# ---------------------------------------------------------------------------
# HSTS fica gravado no navegador pelo tempo declarado e não dá para cancelar
# antes disso. Ao estrear um domínio, comece baixo (3600) e suba depois.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Domínio próprio (opcional) — entra em ALLOWED_HOSTS, CORS e CSRF
# ---------------------------------------------------------------------------
CUSTOM_DOMAIN=
