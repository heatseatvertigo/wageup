# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Em produção (DJANGO_DEBUG=False) o projeto se recusa a subir com a chave de
# exemplo ou com menos de 50 caracteres.
SECRET_KEY=change-me
# O padrão do código é False. Ligue apenas em desenvolvimento local.
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Sem esta variável o projeto usa SQLite em backend/db.sqlite3.
DATABASE_URL=postgres://wageup:wageup@localhost:5432/wageup

# ---------------------------------------------------------------------------
# Pagamentos (Abacate Pay)
# ---------------------------------------------------------------------------
ABACATE_PAY_API_KEY=cole-sua-chave-da-abacate-pay-aqui
# Obrigatório em produção: sem ele o webhook é recusado com 503, porque qualquer
# um poderia postar um evento e marcar uma cobrança como paga.
ABACATE_PAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Papéis de usuário
# ---------------------------------------------------------------------------
WAGEUP_ADMIN_EMAILS=admin@wageup.local

# ---------------------------------------------------------------------------
# Inteligência artificial
# ---------------------------------------------------------------------------
# Anthropic: campanhas de marketing e insights do dashboard.
ANTHROPIC_API_KEY=cole-sua-chave-da-anthropic-aqui
# DeepSeek: assistente financeiro. Sem esta chave o assistente cai para a
# Anthropic e, sem nenhuma das duas, responde localmente avisando que não está
# configurado — em vez de quebrar.
DEEPSEEK_API_KEY=cole-sua-chave-da-deepseek-aqui
# Opcionais: só mude se precisar apontar para outro endpoint ou modelo.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Login com Google (opcional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Limites de requisição (throttling). Valores padrão do código entre parênteses.
# ---------------------------------------------------------------------------
# THROTTLE_ANON=30/min      # visitante não autenticado (30/min)
# THROTTLE_USER=120/min     # usuário autenticado (120/min)
# THROTTLE_AI=60/hour       # rotas que chamam modelo de linguagem (60/hour)
# THROTTLE_LOGIN=10/min     # login, registro e login com Google (10/min)

# ---------------------------------------------------------------------------
# HTTPS / HSTS — só valem quando DJANGO_DEBUG=False
# ---------------------------------------------------------------------------
# HSTS fica gravado no navegador pelo tempo declarado e não dá para cancelar
# antes disso. Ao estrear um domínio, comece baixo (3600) e suba depois.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Domínio próprio (opcional) — entra em ALLOWED_HOSTS, CORS e CSRF
# ---------------------------------------------------------------------------
CUSTOM_DOMAIN=
